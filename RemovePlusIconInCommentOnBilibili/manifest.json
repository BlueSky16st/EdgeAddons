{
  "name": "__MSG_extName__",
  "version": "2.0",
  "manifest_version": 3,
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "Hsin",
  "icons": {
    "16": "imgs/icon16.png",
    "32": "imgs/icon32.png",
    "48": "imgs/icon48.png",
    "128": "imgs/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "imgs/icon16.png",
      "32": "imgs/icon32.png",
      "48": "imgs/icon48.png",
      "128": "imgs/icon128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*"],
      "css": ["src/rm.css"],
      "js": ["src/danmaku-filter.js", "src/rm.js"]
    }
  ]
}
